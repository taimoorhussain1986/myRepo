{
  "compilerOptions": {
    "target": "ES5",
    "module": "amd",
    "lib": ["ES6", "DOM"],
    "noImplicitAny": false,
    "noEmitOnError": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "skipLibCheck": true
  },
  "include": [
    "Operations/**/*.ts",
    "Views/**/*.ts",
    "Messages/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
