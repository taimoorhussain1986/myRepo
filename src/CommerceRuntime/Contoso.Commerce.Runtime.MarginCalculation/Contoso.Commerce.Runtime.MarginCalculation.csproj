<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      TargetFramework: must match your BT.CommerceRuntime project exactly.
      Store Commerce App SDK 9.53.x (D365 10.0.53) uses netstandard2.0.
      Open BT.CommerceRuntime.csproj and check its <TargetFramework> — use the same value here.
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Contoso.Commerce.Runtime.MarginCalculation</AssemblyName>
    <RootNamespace>Contoso.Commerce.Runtime.MarginCalculation</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Deterministic>true</Deterministic>
    <!--
      OUTPUT PATH:
      The DLL is placed in bin\Debug\netstandard2.0\ or bin\Release\netstandard2.0\ relative to this .csproj.
      After build, look here:
        BT.CommerceRuntime\MarginCalculation\bin\Debug\netstandard2.0\
            Contoso.Commerce.Runtime.MarginCalculation.dll
      Deploy to:
        C:\Program Files\Microsoft Dynamics 365\10.0\Commerce Scale Unit\bin\ext\
    -->
  </PropertyGroup>

  <PropertyGroup>
    <!--
      CommerceSDKVersion: must match the version used by BT.CommerceRuntime and BT.POS exactly.
      Your installed version (from the NuGet path in the build errors): 9.53.26002.2
      If your Directory.Build.props already defines $(CommerceSDKVersion), that value is used.
      Otherwise this fallback applies. Update it if your version differs.
    -->
    <CommerceSDKVersion Condition="'$(CommerceSDKVersion)' == ''">9.53.26002.2</CommerceSDKVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      NuGet source for Commerce SDK packages:
        Feed URL: https://pkgs.dev.azure.com/Dynamics365/
                    _packaging/Commerce-SDK/nuget/v3/index.json
      Add this to your solution's nuget.config (the one next to your .sln file)
      under <packageSources> if you get "package not found" errors.

      The version must match your existing BT.CommerceRuntime references exactly.
      To find your version: open BT.CommerceRuntime\packages.config or any
      existing .csproj and check the Microsoft.Dynamics.Commerce.Runtime.* version.
    -->
    <PackageReference Include="Microsoft.Dynamics.Commerce.Runtime.Framework"                Version="$(CommerceSDKVersion)" />
    <PackageReference Include="Microsoft.Dynamics.Commerce.Runtime.Messages"                 Version="$(CommerceSDKVersion)" />
    <PackageReference Include="Microsoft.Dynamics.Commerce.Runtime.RealtimeServices.Messages" Version="$(CommerceSDKVersion)" />
  </ItemGroup>

</Project>
